# Copy file này thành `.env` và điền giá trị thật. KHÔNG commit `.env`.

# -----------------------------------------------------------------------------
# Mô hình đích A1/A2/A3 — khớp khối `targets` trong config/models.yaml. Cả ba đi qua một
# gateway chung tương thích OpenAI. Giá trị phải trùng `model_id` trong config/models.yaml.
# -----------------------------------------------------------------------------
GATEWAY_BASE_URL=
GATEWAY_API_KEY=

# A1 frontier
TARGET_MODEL_A1=claude-opus-5
# A2 lớp doanh nghiệp Việt
TARGET_MODEL_A2=glm-5.2
# A3 lớp rẻ, nhóm đối chiếu
TARGET_MODEL_A3=glm-5.3-flash


# -----------------------------------------------------------------------------
# Hạn mức chi phí (STT-15) — đặt trùng hạn mức trên dashboard nhà cung cấp. Script chạy lô
# đọc hai biến này để cảnh báo ở ngưỡng ALERT_PCT và dừng khi vượt 120% dự toán.
# -----------------------------------------------------------------------------
COST_BUDGET_USD_TOTAL=
COST_BUDGET_USD_ALERT_PCT=80
