# =============================================================================
# W1-11 — Cấu hình 3 mô hình đích (target models)
# Copy file này thành `.env` và điền giá trị thật. KHÔNG commit `.env` lên git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1+2) Hai API tương thích OpenAI, chạy qua CHUNG một gateway (llmgate.app) —
#      "2 nhà cung cấp" được phân biệt bằng MODEL family (OpenAI vs Google/khác),
#      không phải bằng 2 base_url/2 tài khoản riêng. Đây là quyết định đã chốt
#      cho project này (xem docs/cost_budget.md mục "Ghi chú provider").
# -----------------------------------------------------------------------------
OPENAI_COMPATIBLE_BASE_URL=https://llmgate.app/v1
OPENAI_COMPATIBLE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model đích A — họ OpenAI (nhà cung cấp #1)
TARGET_MODEL_A=gpt-5.4-mini

# Model đích B — họ khác OpenAI, vd Google Gemini (nhà cung cấp #2)
TARGET_MODEL_B=gemini-3.1-pro-preview

# -----------------------------------------------------------------------------
# 3) LM Studio — server OpenAI-compatible local, cổng mặc định 1234.
#    Bật "Local Server" trong LM Studio và load 1 model có hỗ trợ tool-calling
#    (vd Qwen2.5-Instruct, Llama-3.1-Instruct bản GGUF) trước khi test.
# -----------------------------------------------------------------------------
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=lm-studio
# Tên model đúng như LM Studio hiển thị (xem tab "My Models" hoặc GET /v1/models)
LOCAL_LLM_MODEL=

# -----------------------------------------------------------------------------
# Hạn mức chi phí (đặt trùng với hạn mức đã cấu hình trên dashboard nhà cung cấp,
# xem docs/cost_budget.md). Dùng để script tự dừng nếu vượt ngưỡng khi chạy lô.
# -----------------------------------------------------------------------------
COST_BUDGET_USD_TOTAL=
COST_BUDGET_USD_ALERT_PCT=80
